<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
        <title>Daily Blogs - Blog</title>
</head>

<body>
    <%- include('./partials/nav') %>
        <div class="container mt-3">
            <h1 class="card-title">
                <%= blog.title %>
            </h1>
            <img src="<%= blog.coverImageUrl %>" width="700px" alt="<%= blog.title %>" />
            <pre><%= blog.body %></pre>
        </div>
        <div class="container mt-4">
            <% const profileImageUrl=blog?.createdBy?.profileImageUrl?.replace('./public', '' )
                || '/Images/blank-profile-picture.png' ; %>
                <img src="<%= profileImageUrl %>" width="50px" alt="<%= blog?.createdBy?.fullName || 'Author' %>" />
                <%= blog?.createdBy?.fullName || 'Unknown author' %>
        </div>
        <div class="container mt-4">
            <h1>Comments (<%= comments?.length %>)</h1>
            <% if (locals.user) { %>
                <form action="/blog/comment/<%= blog._id %>" method="post">
                    <div class="mb-3">
                        <input type="text" name="content" class="form-control" id="content"
                            placeholder="Enter your comment..." />
                    </div>
                    <button type="submit" class="btn btn-primary">Add Comment</button>
                </form>
                <% } %>
                    <div class="mt-3">
                        <% comments.forEach(comment=> { %>
                            <% const commentProfileImageUrl=comment?.createdBy?.profileImageUrl?.replace('./public', ''
                                ) || '/Images/blank-profile-picture.png' ; %>
                                <img src="<%= commentProfileImageUrl %>" width="50px"
                                    alt="<%= comment?.createdBy?.fullName || 'User' %>" />
                                <%= comment?.createdBy?.fullName || 'Unknown user' %>
                                    <pre><%= comment?.content %></pre>
                                    <% }) %>
                    </div>
        </div>
        <%- include('./partials/script') %>
</body>

</html>